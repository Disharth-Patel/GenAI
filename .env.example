APP_NAME="Maharashtra OBC Education Voice AI Chatbot"
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./voice_chatbot.db

# Primary Local Open-Weight LLM Provider (Zero API Keys Required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT=120.0

UPLOAD_DIR=knowledge/uploads
MAX_UPLOAD_MB=15

# Speech provider settings: browser or server
STT_PROVIDER=browser
TTS_PROVIDER=browser

# Knowledge base embedding model (sentence-transformers or fast hybrid TF-IDF)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
USE_LOCAL_EMBEDDINGS=true
